# Hermes Marketing — Self-Managed API Keys
# Hermes agent will fill these automatically via wizard. Do NOT commit real values.
# Copy to .env and fill, or run marketing wizard: node marketing/wizard.mjs

# X (Twitter) — https://developer.twitter.com/en/portal/dashboard
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""
X_BEARER_TOKEN=""

# Reddit — https://www.reddit.com/prefs/apps (create script app)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
REDDIT_USER_AGENT="ShareFlowHermes/1.0"

# Product Hunt — https://api.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_TOKEN=""

# Telegram (Xubuntu 26) — managed via .env on Linux device, not here
TELEGRAM_BOT_TOKEN="" # you have this — Hermes bridge uses it
TELEGRAM_ALLOWED_USERS="8941576242" # whitelisted: 8941576242
HERMES_AUTO_PUSH="true"

# Cloudflare (managed by assistant, not Hermes)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID="f3a3a25638f1935dfec28f9780f18224"

