# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Hermes Telegram (Xubuntu 26, auto-push) — user 8941576242 whitelisted
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USERS="8941576242" # your Telegram user ID — only this user can control Hermes
HERMES_AUTO_PUSH="true" # Q3: auto-push without Telegram confirmation on Xubuntu

# Frontend API — production ShareFlow API
VITE_API_URL="https://shareflow-api.shareflow.workers.dev"

# Cloudflare (or use wrangler login OAuth — already has workers write for f3a3a256...)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID="f3a3a25638f1935dfec28f9780f18224"
