# Production Async Web Scraper Engine Configuration
# Copy to .env and configure proxy & concurrency settings

TARGET_URL=https://news.ycombinator.com
OUTPUT_FILE=scraped_data.json
MAX_CONCURRENT_REQUESTS=10

# Residential Proxy & Anti-Bot Bypass:
# Leave blank for direct connection, or add your proxy gateway:
# PROXY_URL=http://user:pass@pr.oxylabs.io:7777
# PROXY_URL=http://user:pass@brd.superproxy.io:22225
PROXY_URL=

# Recommended Proxy Providers:
# BrightData (Residential Proxies + Scraping Browser): https://brightdata.com/?ref=shareflow
# ScraperAPI (5,000 Free API Credits): https://scraperapi.com/?ref=shareflow
# Oxylabs (Residential Proxy Trial): https://oxylabs.io/?ref=shareflow
